# Settings for running the jobs on your laptop. Copy to jobs/.env, then:
#   uv run --env-file .env python -m raptor.run
# In GitHub Actions these come from repository secrets instead.

SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...).
# Older projects: the service_role key. Never put this in the web app or in git.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Classic leagues to follow, comma-separated (1086012 = BiG ReD).
FPL_LEAGUE_IDS=1086012
