# Web app settings. Copy to .env.local for local development, and add the
# same two values in Vercel -> Project -> Settings -> Environment Variables.
# Both are safe to expose in the browser; row-level security protects the data.

# Supabase -> Project Settings -> Data API (or the Connect button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API Keys -> Publishable key (sb_publishable_...)
# Older projects: use the anon key instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Enable only after configuring Google in Supabase Auth (see docs/AUTH_SETUP.md).
# APP_URL is this app's canonical origin, not the Supabase project URL.
GOOGLE_AUTH_ENABLED=false
APP_URL=http://localhost:3000
